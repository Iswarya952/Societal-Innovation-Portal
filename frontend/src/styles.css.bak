* { box-sizing: border-box; }
:root {
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #12213a; background: #f5f8fc; font-synthesis: none;
}
body { margin: 0; min-width: 320px; }
button, input, select { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
a { color: inherit; text-decoration: none; }

.app-shell { min-height: 100vh; display: flex; flex-direction: column; }
.topbar {
  height: 72px; padding: 0 28px; display: flex; align-items: center; justify-content: space-between;
  background: #fff; border-bottom: 1px solid #dfe6ef; position: sticky; top: 0; z-index: 10;
}
.brand { display: flex; align-items: center; gap: 11px; }
.brand strong { display:block; font-size: 19px; letter-spacing: -.02em; }
.brand small { display:block; color:#6b7890; font-size: 11px; margin-top: 2px; }
.brand-mark {
  width: 36px; height: 36px; display:grid; place-items:center; border-radius: 10px;
  background: #123d78; color:#fff; font-weight: 800;
}
.brand-mark.large { width:44px; height:44px; border-radius:12px; }
.topbar-right { display:flex; align-items:center; gap:12px; }
.role-pill, .status-badge {
  border: 1px solid #cdd9e8; background:#f4f7fb; padding:7px 11px; border-radius:999px;
  font-size:12px; font-weight:700; color:#29466f;
}
.sidebar {
  position: fixed; left:0; top:72px; bottom:0; width:238px; padding:24px 14px;
  background:#0e294d; color:#dbe8f8; display:flex; flex-direction:column;
}
.workspace-title { font-weight:800; padding:0 10px 16px; color:#fff; }
.nav-link { display:block; padding:11px 12px; border-radius:8px; color:#b8c9df; font-size:14px; margin:2px 0; }
.nav-link:hover, .nav-link.active { background:#173e6d; color:#fff; }
.sidebar-note { margin-top:auto; padding:13px; border:1px solid #2b4d76; border-radius:10px; font-size:12px; color:#b9cae0; }
.sidebar-note strong { color:#fff; }
.sidebar-note p { margin:5px 0 0; line-height:1.45; }
.main-content { flex:1; }
.main-content.with-sidebar { margin-left:238px; }
.footer {
  padding:18px 28px; display:flex; justify-content:space-between; color:#78869a; font-size:12px;
  border-top:1px solid #dfe6ef; background:#fff;
}

.auth-page {
  min-height: calc(100vh - 72px); display:grid; grid-template-columns: 1.15fr .85fr;
  align-items:center; gap:56px; padding:60px clamp(24px, 8vw, 120px);
  background:linear-gradient(120deg,#eef5fc,#fff);
}
.auth-hero { max-width:680px; }
.eyebrow { color:#2461a4; font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; margin-bottom:12px; }
.auth-hero h1 { font-size:clamp(34px,4vw,58px); line-height:1.04; letter-spacing:-.04em; margin:0 0 18px; }
.auth-hero p { max-width:600px; color:#586981; font-size:17px; line-height:1.65; }
.flow-strip {
  display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin-top:28px; color:#24486f; font-weight:700; font-size:13px;
}
.flow-strip span { background:#fff; border:1px solid #d7e1ec; padding:8px 10px; border-radius:8px; }
.flow-strip b { color:#91a1b5; }
.auth-card, .registration-card, .success-card {
  background:#fff; border:1px solid #dce4ed; border-radius:16px; padding:28px;
  box-shadow:0 14px 45px rgba(21,54,92,.08);
}
.auth-card { max-width:480px; width:100%; justify-self:end; }
.card-heading { display:flex; gap:13px; align-items:center; margin-bottom:24px; }
.card-heading h2 { margin:0; font-size:22px; }
.card-heading p { margin:4px 0 0; color:#748197; font-size:13px; }
form { display:grid; gap:16px; }
label { display:grid; gap:7px; color:#34465f; font-weight:700; font-size:13px; }
input, select {
  width:100%; padding:11px 12px; border:1px solid #cbd7e5; border-radius:8px; background:#fff; color:#1d304b; outline:none;
}
input:focus, select:focus { border-color:#3472b8; box-shadow:0 0 0 3px rgba(52,114,184,.12); }
.form-row { display:flex; justify-content:space-between; align-items:center; gap:10px; }
.checkbox { display:flex; grid-template-columns:none; align-items:center; gap:7px; font-weight:500; }
.checkbox input { width:auto; }
.text-button { border:0; background:none; color:#1e5d9c; cursor:pointer; padding:0; }
.primary-button, .secondary-button, .ghost-button {
  display:inline-flex; justify-content:center; align-items:center; gap:8px; border-radius:8px; padding:11px 15px;
  border:1px solid transparent; cursor:pointer; font-weight:800; font-size:13px;
}
.primary-button { background:#14579a; color:#fff; }
.primary-button:hover { background:#0f477f; }
.secondary-button { background:#fff; border-color:#c9d6e4; color:#24486f; }
.ghost-button { background:transparent; border-color:#d2dce8; color:#36516f; }
.full { width:100%; }
.divider { display:flex; align-items:center; gap:10px; color:#8a96a8; font-size:12px; margin:18px 0 12px; }
.divider:before,.divider:after { content:""; height:1px; background:#e2e7ee; flex:1; }
.demo-hint { color:#7c889a; font-size:11px; line-height:1.5; margin:16px 0 0; }

.form-page { max-width:900px; margin:0 auto; padding:56px 24px; }
.page-intro { margin-bottom:24px; }
.page-intro h1 { margin:0 0 8px; font-size:34px; letter-spacing:-.03em; }
.page-intro p { margin:0; color:#69788e; }
.registration-card { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
.registration-card .privacy-note, .registration-card .primary-button, .registration-card .secondary-button { grid-column:1 / -1; }
.privacy-note { padding:12px 14px; background:#f5f8fc; border:1px solid #e0e7ef; border-radius:8px; color:#63738a; font-size:12px; line-height:1.5; }
.center-page { min-height:calc(100vh - 130px); display:grid; place-items:center; padding:40px 20px; }
.success-card { max-width:600px; text-align:center; }
.success-icon { width:50px; height:50px; margin:0 auto 14px; display:grid; place-items:center; border-radius:50%; background:#e8f5ec; color:#21743d; font-size:24px; font-weight:900; }
.success-card h1 { margin:0 0 8px; }
.success-card p { color:#68778d; line-height:1.6; }
.button-row { display:flex; justify-content:center; flex-wrap:wrap; gap:10px; margin-top:20px; }

.workspace { max-width:1200px; margin:0 auto; padding:38px 28px 56px; }
.workspace-header { display:flex; justify-content:space-between; gap:24px; align-items:flex-start; margin-bottom:22px; }
.workspace-header h1 { margin:0 0 8px; font-size:32px; letter-spacing:-.03em; }
.workspace-header p { margin:0; color:#6b7890; }
.info-banner { display:flex; gap:10px; flex-wrap:wrap; padding:15px 16px; border:1px solid #cfe0f1; background:#f2f7fc; border-radius:10px; margin-bottom:20px; color:#47617e; font-size:13px; }
.info-banner strong { color:#173e6d; }
.metric-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:20px; }
.metric-card { padding:18px; background:#fff; border:1px solid #dce4ed; border-radius:11px; }
.metric-card span { display:block; color:#718096; font-size:12px; }
.metric-card strong { display:block; margin-top:8px; font-size:28px; }
.foundation-grid { display:grid; grid-template-columns:1.4fr .9fr; gap:18px; }
.panel { background:#fff; border:1px solid #dce4ed; border-radius:12px; padding:20px; }
.panel-heading { display:flex; justify-content:space-between; align-items:center; margin-bottom:18px; }
.panel-heading h2 { margin:0; font-size:16px; }
.panel-heading span { color:#7a8799; font-size:11px; font-weight:800; text-transform:uppercase; }
.lifecycle { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
.lifecycle-step { display:flex; gap:8px; align-items:center; padding:10px; background:#f7f9fc; border:1px solid #e3e8ef; border-radius:8px; color:#63738a; font-size:12px; }
.lifecycle-step span { width:23px; height:23px; display:grid; place-items:center; border-radius:50%; background:#dce5ef; color:#42566e; font-weight:800; }
.lifecycle-step.current { background:#eef6ff; border-color:#b9d5ef; color:#245c92; }
.lifecycle-step.current span { background:#1c659f; color:#fff; }
.check-list { margin:0; padding:0; list-style:none; display:grid; gap:12px; }
.check-list li { font-size:13px; color:#5f6f84; padding-left:23px; position:relative; line-height:1.45; }
.check-list li:before { content:"✓"; position:absolute; left:0; color:#2a7c4b; font-weight:900; }
.empty-page { min-height:calc(100vh - 150px); display:grid; place-content:center; justify-items:center; gap:8px; padding:40px; text-align:center; }
.empty-icon { width:52px; height:52px; display:grid; place-items:center; border-radius:12px; background:#eaf1f8; color:#2a5c8e; font-size:25px; font-weight:900; }
.empty-page h1 { margin:4px 0 0; }
.empty-page p { color:#718096; }

@media (max-width: 900px) {
  .auth-page { grid-template-columns:1fr; gap:28px; padding:38px 24px; }
  .auth-card { justify-self:stretch; max-width:none; }
  .auth-hero h1 { font-size:40px; }
  .metric-grid { grid-template-columns:1fr 1fr; }
  .foundation-grid { grid-template-columns:1fr; }
}
@media (max-width: 700px) {
  .topbar { padding:0 16px; }
  .topbar .role-pill { display:none; }
  .sidebar { position:static; width:auto; height:auto; padding:10px; flex-direction:row; overflow:auto; }
  .workspace-title, .sidebar-note { display:none; }
  .nav-link { white-space:nowrap; }
  .main-content.with-sidebar { margin-left:0; }
  .footer { padding:14px 16px; flex-direction:column; gap:5px; }
  .registration-card { grid-template-columns:1fr; }
  .registration-card .privacy-note, .registration-card .primary-button, .registration-card .secondary-button { grid-column:auto; }
  .workspace { padding:28px 16px 44px; }
  .workspace-header { flex-direction:column; }
  .metric-grid { grid-template-columns:1fr 1fr; }
  .lifecycle { grid-template-columns:1fr; }
}
@media (max-width: 430px) {
  .auth-page { padding:28px 16px; }
  .auth-hero h1 { font-size:32px; }
  .auth-card { padding:20px; }
  .metric-grid { grid-template-columns:1fr; }
}

/* Citizen workflow additions */
.role-citizen .sidebar { background:#123d5a; }
.role-citizen .nav-link:hover, .role-citizen .nav-link.active { background:#1b5679; }
.role-citizen .primary-button { background:#146b5c; }
.role-citizen .primary-button:hover { background:#0f5a4d; }
.role-citizen .brand-mark { background:#146b5c; }

.limit-banner { display:flex; justify-content:space-between; gap:24px; align-items:center; padding:16px 18px; margin-bottom:18px; background:#fffaf0; border:1px solid #ead9b1; border-radius:12px; }
.limit-banner > div:first-child { display:grid; gap:4px; }
.limit-banner strong { color:#5b461c; font-size:14px; }
.limit-banner span { color:#7d6b43; font-size:12px; }
.limit-meter { min-width:280px; display:grid; gap:5px; }
.limit-meter strong { text-align:right; font-size:13px; }
.limit-meter > div { height:7px; border-radius:99px; background:#eee4cb; overflow:hidden; }
.limit-meter > div span { display:block; height:100%; border-radius:99px; background:#c7922d; }
.limit-meter small { color:#7d6b43; font-size:11px; text-align:right; }
.citizen-actions { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:18px; }
.action-card { display:flex; align-items:center; gap:13px; padding:17px; background:#fff; border:1px solid #dce4ed; border-radius:12px; transition:.15s ease; }
.action-card:hover { border-color:#aac7d9; transform:translateY(-1px); }
.action-card .action-icon { width:40px; height:40px; display:grid; place-items:center; border-radius:10px; background:#e8f4f1; color:#146b5c; font-size:22px; }
.action-card div { flex:1; }
.action-card strong { display:block; font-size:14px; }
.action-card p { margin:4px 0 0; color:#718096; font-size:12px; }
.action-card > b { color:#7890a5; }
.citizen-grid { display:grid; grid-template-columns:1.45fr .8fr; gap:18px; }
.citizen-status-cards { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-bottom:18px; }
.status-mini { padding:12px; border:1px solid #e3e8ef; border-radius:9px; background:#f8fafc; }
.status-mini span { display:block; color:#718096; font-size:10px; }
.status-mini strong { display:block; margin-top:5px; font-size:20px; }
.text-link { color:#1c659f; font-size:12px; font-weight:800; }
.progress-card { border:1px solid #dce4ed; border-radius:10px; padding:16px; background:#fff; }
.progress-card-head { display:flex; justify-content:space-between; gap:16px; }
.challenge-id { color:#6e8198; font-size:10px; font-weight:800; letter-spacing:.05em; }
.progress-card h3 { margin:4px 0; font-size:16px; }
.progress-card p { margin:0; color:#718096; font-size:11px; }
.progress-track { display:grid; grid-template-columns:repeat(9,1fr); gap:4px; margin:22px 0 14px; }
.progress-step { text-align:center; min-width:0; }
.progress-step span { width:24px; height:24px; display:grid; place-items:center; margin:0 auto 5px; border-radius:50%; background:#e5ebf2; color:#66798f; font-size:10px; font-weight:800; position:relative; }
.progress-step:not(:last-child) span:after { content:""; position:absolute; left:100%; top:11px; width:calc(100% + 4px); height:2px; background:#e5ebf2; z-index:0; }
.progress-step small { display:block; color:#7b8899; font-size:9px; line-height:1.2; }
.progress-step.done span, .progress-step.current span { background:#146b5c; color:#fff; }
.progress-step.done span:after { background:#82b9ad; }
.progress-step.current small { color:#146b5c; font-weight:800; }
.progress-explain { padding:11px 12px; border-radius:8px; background:#f1f7f6; display:grid; gap:3px; }
.progress-explain strong { font-size:12px; color:#165f54; }
.progress-explain span { color:#5d756f; font-size:11px; line-height:1.45; }
.challenge-list { display:grid; gap:4px; margin-bottom:14px; }
.challenge-row { display:flex; justify-content:space-between; gap:10px; padding:11px 0; border-bottom:1px solid #edf0f4; }
.challenge-row strong { font-size:12px; }
.challenge-row p { margin:4px 0 0; color:#7a8799; font-size:10px; }
.priority { display:inline-flex; align-items:center; height:22px; padding:0 8px; border-radius:99px; font-size:9px; font-weight:800; }
.priority.low { background:#edf5ef; color:#3b7651; }.priority.medium { background:#eef3fa; color:#3b5f89; }.priority.high { background:#fff2df; color:#99621e; }.priority.critical { background:#fde9e8; color:#a43b36; }
.inline-empty { padding:20px 10px; text-align:center; display:grid; justify-items:center; gap:6px; }
.inline-empty p { margin:0 0 5px; color:#748196; font-size:12px; max-width:430px; line-height:1.5; }
.empty-icon.small { width:38px; height:38px; font-size:18px; }

.report-page { max-width:1050px; margin:0 auto; padding:36px 28px 60px; }
.report-header { display:flex; justify-content:space-between; align-items:flex-start; gap:20px; margin-bottom:22px; }
.report-header h1 { margin:0 0 8px; font-size:32px; letter-spacing:-.03em; }
.report-header p { margin:0; color:#68778d; font-size:13px; }
.limit-chip { padding:9px 12px; border:1px solid #d8e3ec; border-radius:999px; background:#fff; color:#46627d; font-size:11px; font-weight:800; white-space:nowrap; }
.stepper { display:grid; grid-template-columns:repeat(5,1fr); margin-bottom:16px; }
.stepper-item { position:relative; display:grid; justify-items:center; gap:7px; color:#8492a3; font-size:10px; text-align:center; }
.stepper-item:not(:last-child):after { content:""; position:absolute; top:13px; left:calc(50% + 14px); width:calc(100% - 28px); height:2px; background:#e1e7ee; }
.stepper-item span { width:28px; height:28px; display:grid; place-items:center; border-radius:50%; background:#e5ebf2; font-weight:800; z-index:1; }
.stepper-item.active { color:#146b5c; font-weight:800; }.stepper-item.active span { background:#146b5c; color:#fff; }.stepper-item.done { color:#47776e; }.stepper-item.done span { background:#9bc9bf; color:#fff; }.stepper-item.done:after { background:#9bc9bf; }
.report-card { background:#fff; border:1px solid #dce4ed; border-radius:14px; padding:26px; box-shadow:0 10px 35px rgba(21,54,92,.05); }
.form-section { display:grid; gap:17px; }
.section-title { margin-bottom:3px; }.section-title h2 { margin:0 0 5px; font-size:20px; }.section-title p { margin:0; color:#718096; font-size:12px; line-height:1.5; }
textarea { width:100%; resize:vertical; min-height:130px; padding:11px 12px; border:1px solid #cbd7e5; border-radius:8px; background:#fff; color:#1d304b; outline:none; font:inherit; }
textarea:focus { border-color:#3472b8; box-shadow:0 0 0 3px rgba(52,114,184,.12); }
.two-col { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
.field-help { color:#7c899b; font-size:10px; font-weight:500; }
.map-placeholder { display:flex; align-items:center; gap:12px; padding:15px; border:1px dashed #b9c9d8; border-radius:10px; background:#f8fafc; }.map-placeholder > span { font-size:25px; color:#246a61; }.map-placeholder div { flex:1; }.map-placeholder strong { font-size:12px; }.map-placeholder p { margin:3px 0 0; color:#7a8799; font-size:10px; line-height:1.4; }
.upload-box { border:1px dashed #aebfd0; border-radius:11px; padding:28px 18px; display:grid; justify-items:center; text-align:center; cursor:pointer; background:#fbfcfe; }.upload-box:hover { border-color:#6d9bb9; background:#f7fbff; }.upload-icon { width:42px; height:42px; display:grid; place-items:center; border-radius:10px; background:#eaf2f8; color:#1c659f; font-size:22px; margin-bottom:8px; }.upload-box strong { font-size:13px; }.upload-box p { margin:4px 0; color:#77869a; font-size:10px; }.upload-box > span { color:#1c659f; font-size:10px; font-weight:800; }
.media-list { display:grid; gap:7px; }.media-item { display:flex; align-items:center; gap:10px; padding:10px; border:1px solid #e0e6ed; border-radius:8px; }.media-item > span { width:28px; height:28px; display:grid; place-items:center; background:#edf4f8; border-radius:7px; color:#3e6e8e; }.media-item div { flex:1; }.media-item strong,.media-item small { display:block; }.media-item strong { font-size:11px; }.media-item small { color:#7a8799; font-size:9px; margin-top:2px; }.remove-button { border:0; background:none; color:#a24742; font-size:10px; font-weight:800; cursor:pointer; }
.voice-box { display:flex; align-items:center; gap:12px; flex-wrap:wrap; padding:14px; border:1px solid #dce4ed; border-radius:10px; }.voice-box > div:first-child { flex:1; }.voice-box strong { font-size:12px; }.voice-box p { margin:3px 0 0; color:#77869a; font-size:10px; }.recording { animation:pulse 1.4s infinite; }.voice-ready { flex-basis:100%; color:#277251; font-size:10px; font-weight:800; }
@keyframes pulse { 50% { opacity:.65; } }
.chip-grid { display:flex; flex-wrap:wrap; gap:8px; margin-top:-7px; }.choice-chip { border:1px solid #ccd8e4; background:#fff; color:#53677f; border-radius:99px; padding:8px 11px; font-size:11px; font-weight:700; cursor:pointer; }.choice-chip.selected { border-color:#76b4a8; background:#eaf5f2; color:#146b5c; }
.review-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }.review-item { padding:12px; border:1px solid #e2e8ee; border-radius:8px; background:#fafbfd; }.review-item span { display:block; color:#7a8799; font-size:9px; text-transform:uppercase; font-weight:800; letter-spacing:.06em; }.review-item strong { display:block; margin-top:5px; color:#2e4058; font-size:12px; line-height:1.45; white-space:pre-wrap; }
.privacy-note { line-height:1.5; }.form-error { padding:11px 13px; border:1px solid #edc3c0; background:#fff2f1; color:#9b413b; border-radius:8px; font-size:11px; font-weight:700; }.report-actions { display:flex; justify-content:space-between; gap:10px; margin-top:24px; padding-top:18px; border-top:1px solid #e7ebf0; }
.limit-block { padding:28px; border:1px solid #ead9b1; border-radius:12px; background:#fffaf0; }.limit-block strong { font-size:18px; color:#5b461c; }.limit-block p { color:#7d6b43; font-size:12px; line-height:1.5; margin:7px 0 16px; }
.submission-success { max-width:850px; }.submission-id { display:flex; justify-content:space-between; gap:20px; padding:12px 15px; background:#f3f7fa; border:1px solid #dce5ed; border-radius:9px; margin:15px 0; }.submission-id span { color:#738298; font-size:10px; }.submission-id strong { color:#1d5f8d; font-size:13px; }
.challenge-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:14px; }.challenge-card { background:#fff; border:1px solid #dce4ed; border-radius:11px; padding:17px; }.challenge-card-top,.challenge-card-bottom { display:flex; justify-content:space-between; gap:10px; align-items:center; }.challenge-card h3 { margin:12px 0 5px; font-size:16px; }.challenge-card > p { margin:0; color:#728095; font-size:11px; }.challenge-impact { display:flex; align-items:baseline; gap:6px; padding:15px 0; }.challenge-impact strong { font-size:23px; }.challenge-impact span { color:#748196; font-size:10px; }.challenge-card-bottom > span:last-child { color:#738298; font-size:9px; }.tracking-list { display:grid; gap:14px; }.tracking-card { background:#fff; border:1px solid #dce4ed; border-radius:12px; padding:5px; }

@media (max-width:900px) { .citizen-grid { grid-template-columns:1fr; }.limit-banner { align-items:flex-start; flex-direction:column; }.limit-meter { width:100%; min-width:0; }.citizen-actions { grid-template-columns:1fr; }.challenge-grid { grid-template-columns:1fr; } }
@media (max-width:700px) { .report-page { padding:28px 16px 45px; }.report-header { flex-direction:column; }.stepper-item small { font-size:8px; }.report-card { padding:18px; }.two-col,.review-grid { grid-template-columns:1fr; }.citizen-status-cards { grid-template-columns:1fr 1fr; }.progress-track { overflow-x:auto; grid-template-columns:repeat(9,80px); padding-bottom:6px; }.progress-step:not(:last-child) span:after { width:84px; }.map-placeholder { align-items:flex-start; flex-wrap:wrap; }.map-placeholder div { min-width:180px; }.map-placeholder button { margin-left:40px; }.report-actions { position:sticky; bottom:0; background:#fff; margin-left:-18px; margin-right:-18px; padding:14px 18px; z-index:3; } }

/* Citizen detail, notifications and profile */
.breadcrumb { display:flex; gap:8px; align-items:center; color:#718096; font-size:12px; margin-bottom:18px; }
.breadcrumb a { color:#1c659f; font-weight:800; }
.detail-header { display:flex; justify-content:space-between; gap:20px; align-items:flex-start; margin-bottom:20px; }
.detail-header h1 { margin:0 0 8px; font-size:34px; letter-spacing:-.03em; }
.detail-header p { margin:0; color:#6f7d91; }
.detail-layout { display:grid; grid-template-columns:1fr 320px; gap:18px; }
.detail-main, .detail-side { display:grid; gap:18px; align-content:start; }
.detail-description { margin:0; color:#52647a; line-height:1.7; font-size:14px; }
.detail-facts { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-top:20px; }
.detail-facts div { padding:12px; border:1px solid #e2e8ef; border-radius:9px; background:#f8fafc; }
.detail-facts span, .profile-fields span { display:block; color:#7b8899; font-size:10px; }
.detail-facts strong, .profile-fields strong { display:block; margin-top:4px; font-size:13px; }
.next-steps { display:grid; gap:14px; }
.next-steps > div { display:flex; gap:12px; }
.next-steps > div > span { width:28px; height:28px; display:grid; place-items:center; border-radius:50%; background:#e8f4f1; color:#146b5c; font-size:10px; font-weight:900; flex:none; }
.next-steps strong { font-size:13px; }
.next-steps p { margin:4px 0 0; color:#718096; font-size:11px; line-height:1.5; }
.side-copy { color:#6b7890; font-size:12px; line-height:1.6; margin:0 0 14px; }
.selected-button { background:#e9f5f1 !important; color:#146b5c !important; border-color:#a9d3c8 !important; }
.detail-list { margin:0; padding-left:18px; color:#66768b; font-size:12px; line-height:1.7; }
.notification-list { max-width:850px; display:grid; gap:10px; }
.notification-card { display:flex; gap:12px; padding:16px; border:1px solid #dce4ed; background:#fff; border-radius:11px; }
.notification-card.unread { border-left:4px solid #146b5c; }
.notification-dot { width:28px; height:28px; display:grid; place-items:center; border-radius:50%; background:#e8f4f1; color:#146b5c; font-size:20px; flex:none; }
.notification-card strong { font-size:13px; }
.notification-card p { margin:4px 0; color:#66768b; font-size:12px; line-height:1.5; }
.notification-card small { color:#8a96a8; font-size:10px; }
.profile-grid { display:grid; grid-template-columns:360px 1fr; gap:18px; }
.profile-card { text-align:center; }
.avatar { width:64px; height:64px; display:grid; place-items:center; margin:0 auto 12px; border-radius:50%; background:#146b5c; color:#fff; font-size:20px; font-weight:900; }
.profile-card h2 { margin:0 0 8px; font-size:20px; }
.profile-fields { display:grid; gap:10px; text-align:left; margin-top:22px; }
.profile-fields div { padding:12px; border:1px solid #e2e8ef; border-radius:9px; }
.challenge-card { text-decoration:none; color:inherit; }
@media (max-width: 800px) { .detail-layout, .profile-grid { grid-template-columns:1fr; } .detail-header { flex-direction:column; } .detail-facts { grid-template-columns:1fr; } }
